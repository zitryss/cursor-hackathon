{
	"name": "my-fitness",
	"private": true,
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"packageManager": "pnpm@11.13.1",
	"type": "module",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"routes": "react-router routes --json",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"typecheck": "react-router typegen && tsc --noEmit",
		"deps:check": "pnpm outdated --format=json",
		"deps:update:runtime": "pnpm up --latest --prod && pnpm up --latest @react-router/dev @types/react @types/react-dom",
		"deps:update:tooling": "pnpm up --latest --dev && pnpm up --latest react react-dom @react-router/node @react-router/serve react-router",
		"test": "vitest run --reporter=agent --passWithNoTests",
		"test:e2e": "playwright test --reporter=line",
		"verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build",
		"verify:full": "pnpm run verify && pnpm run test:e2e",
		"doctor": "react-doctor"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@react-router/node": "8.2.0",
		"@react-router/serve": "8.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"isbot": "^5.2.1",
		"lucide-react": "^1.25.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.82.0",
		"react-router": "8.2.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/preset-typescript": "7.29.7",
		"@biomejs/biome": "2.5.4",
		"@playwright/cli": "0.1.17",
		"@playwright/test": "1.61.1",
		"@react-router/dev": "8.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"babel-plugin-react-compiler": "1.0.0",
		"react-doctor": "0.8.3",
		"shadcn": "4.14.0",
		"svgo": "4.1.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.1",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vite-plugin-babel": "1.7.3",
		"vitest": "4.1.11"
	}
}
