{
	"name": "@taxfix/taxlens-extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "TaxLens \u2014 the point-of-purchase entry into the Taxfix Tax Plan.",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"typecheck": "wxt prepare && tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@taxfix/taxlens-core": "workspace:*",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@wxt-dev/module-react": "1.2.2",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"wxt": "0.21.4"
	}
}
